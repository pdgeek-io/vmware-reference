#cloud-config
ssh_pwauth: true
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ${hostname}
    username: ${username}
    password: '${password}'
  network:
    version: 2
    renderer: networkd
    ethernets:
      vmware:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - ${ssh_key}
  storage:
    layout:
      name: lvm
  packages:
    - openssh-server
    - open-vm-tools
    - python3
    - python3-pip
    - curl
    - wget
    - jq
  late-commands:
    - echo '${username} ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/${username}
    - chmod 0440 /target/etc/sudoers.d/${username}
    - "password_plain=$(printf '%s' '${password_b64}' | base64 -d) && printf '%s:%s\n' '${username}' \"$password_plain\" | chroot /target chpasswd"
    - curtin in-target -- install -d -m 0755 /etc/ssh/sshd_config.d
    - "printf '%s\n' 'PasswordAuthentication yes' 'KbdInteractiveAuthentication yes' 'PermitRootLogin no' > /target/etc/ssh/sshd_config.d/99-packer-build.conf"
    - "printf '%s\n' 'network:' '  version: 2' '  renderer: networkd' '  ethernets:' '    vmware:' '      match:' '        name: \"en*\"' '      dhcp4: true' '      dhcp6: false' > /target/etc/netplan/01-packer-dhcp.yaml"
    - curtin in-target -- systemctl enable systemd-networkd systemd-resolved open-vm-tools ssh
    - curtin in-target -- ufw allow OpenSSH
    - curtin in-target -- ufw --force disable
    - touch /target/etc/cloud/cloud-init.disabled
    - curtin in-target -- systemctl disable cloud-init-local.service cloud-init.service cloud-config.service cloud-final.service
    - curtin in-target -- systemctl mask cloud-init-local.service cloud-init.service cloud-config.service cloud-final.service
    - curtin in-target -- rm -rf /var/lib/cloud
    # Enable weekly TRIM/UNMAP for thin-provisioned disk reclaim on PowerStore
    - curtin in-target -- systemctl enable fstrim.timer
    - "curtin in-target -- sed -i 's/^.*issue_discards = .*/\\tissue_discards = 1/' /etc/lvm/lvm.conf"
