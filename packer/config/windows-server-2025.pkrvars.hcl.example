# Copy to windows-server-2025.pkrvars.hcl and fill in local values.
# Do not commit the copied file; *.pkrvars.hcl is ignored.

# Pipeline builds should use a vSphere datastore or content library ISO path so
# the runner does not depend on workstation-local media.
windows_iso_paths = [
  "[datastore1] iso/windows-server-2025.iso",
]

# Manual workstation builds may use a local file URL instead. Do not set both
# windows_iso_paths and windows_iso_url for a real build.
# windows_iso_url = "file:///Users/levioister/Downloads/SWDVD9_WinSrvSTDCORE2025_24H2.16_64Bit_English_DC_STD_MLF_RTMUpdJan26_X24-26760.ISO"
windows_iso_url      = ""
windows_iso_checksum = "sha256:cf96e924b4e7551169e09ef2a42d81340cdef11eaadf4bd4ac7bf1cdad5178a4"

windows_image_name = "Windows Server 2025 SERVERSTANDARDCORE"

# Option A: attach a preflighted ESXi-hosted VMware Tools ISO after the OS ISO.
# Confirm /usr/lib/vmware/isoimages/windows.iso exists on the selected ESXi host
# before enabling this, because productLocker symlink issues can make it absent.
vmware_tools_iso_path = ""

# Option B: leave vmware_tools_iso_path empty and provide an HTTPS installer URL
# reachable from the guest during the Packer build.
vmware_tools_installer_url = ""

winrm_username = "Administrator"

# Avoid XML-reserved characters (<, >, &) because this bootstrap password is
# injected into Autounattend.xml during Windows setup.
winrm_password = "CHANGE_ME"

# Restrict this to the Packer runner IP/CIDR during real validation.
winrm_allowed_remote_addresses = "Any"
