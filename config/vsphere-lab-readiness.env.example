# vSphere lab readiness validation inputs.
# Copy to config/vsphere-lab-readiness.env and set lab-specific values.
# Do not put secrets in this file.

# DNS service that should resolve lab records.
# Leave empty to use the workstation default resolver.
VSPHERE_DNS_SERVER="10.100.20.17"

# Space-delimited FQDNs required for the minimal ESXi + vCenter lab.
VSPHERE_REQUIRED_FQDNS="vc-01.lab.pdgeek.local esx-01.lab.pdgeek.local esx-02.lab.pdgeek.local esx-03.lab.pdgeek.local"

# NTP service that lab workloads should use.
VSPHERE_NTP_SERVER="10.100.20.17"

# Set true when this validator runs from a network path that must reach lab NTP.
VSPHERE_NTP_REQUIRED="false"

# Optional vCenter endpoint. Leave empty until VCSA is deployed.
VCENTER_URL=""

# Lab VCSA commonly uses self-signed TLS until PKI automation is in place.
VCENTER_TLS_VERIFY="false"
